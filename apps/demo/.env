# jeeflow demo 多后端配置
# 各后端 API 前缀（对应 vite proxy）
VITE_BACKEND_JAVA=/java-api
VITE_BACKEND_GO=/go-api
VITE_BACKEND_PYTHON=/python-api
VITE_BACKEND_NODE=/node-api
VITE_BACKEND_PHP=/php-api
VITE_BACKEND_RUST=/rust-api

# 离线后端标记（取消注释即禁用对应后端按钮）
# VITE_JAVA_DISABLED=true
# VITE_GO_DISABLED=true
# VITE_PYTHON_DISABLED=true
# VITE_NODE_DISABLED=true
# VITE_PHP_DISABLED=true
# VITE_RUST_DISABLED=true
