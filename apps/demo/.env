# jeeflow demo 后端路径配置
# 开发环境：相对路径走 vite proxy，或直接写 http://localhost:端口
# 生产环境：相对路径走 nginx proxy
# disabled=true 表示该后端不在线，前端按钮灰色不可点击

VITE_BACKEND_JAVA=/java-api
VITE_JAVA_DISABLED=false
VITE_BACKEND_GO=/go-api
VITE_GO_DISABLED=false
VITE_BACKEND_PYTHON=/python-api
VITE_PYTHON_DISABLED=false
VITE_BACKEND_NODE=/node-api
VITE_NODE_DISABLED=false